{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infraguide.local/case.schema.json",
  "title": "InfraGuide case",
  "type": "object",
  "required": ["id", "name", "kind", "caseMode", "sections"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "kindLabel": { "type": "string" },
    "caseMode": { "type": "string", "enum": ["MODEL_SOLVED", "STUDENT_WORK"] },
    "stagesUnlocked": { "type": "boolean" },
    "reportAvailable": { "type": "boolean" },
    "sector": { "type": "string" },
    "organizationType": { "type": "string" },
    "summary": { "type": "string" },
    "pedagogicalNote": { "type": "string" },
    "readOnly": { "type": "boolean" },
    "useButtonLabel": { "type": "string" },
    "sourceDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "file"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "type": { "type": "string" },
          "pages": { "type": ["number", "null"] },
          "version": { "type": "string" },
          "linked": { "type": "boolean" },
          "placeholder": { "type": "boolean" },
          "status": { "type": "string" },
          "note": { "type": "string" },
          "sections": { "type": "array" }
        }
      }
    },
    "evidenceRegistry": { "type": "array" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sectionId", "sectionTitle", "blocks"],
        "properties": {
          "sectionId": { "type": "string" },
          "sectionTitle": { "type": "string" },
          "index": { "type": "number" },
          "groupId": { "type": "string" },
          "summary": { "type": "string" },
          "blocks": { "type": "array" }
        }
      }
    }
  }
}
