{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infraguide.local/case.schema.json",
  "title": "InfraGuide case",
  "type": "object",
  "required": ["id", "name", "kind", "sections"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "kindLabel": { "type": "string" },
    "sector": { "type": "string" },
    "organizationType": { "type": "string" },
    "summary": { "type": "string" },
    "pedagogicalNote": { "type": "string" },
    "readOnly": { "type": "boolean" },
    "useButtonLabel": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sectionId", "sectionTitle", "blocks"],
        "properties": {
          "sectionId": { "type": "string" },
          "sectionTitle": { "type": "string" },
          "index": { "type": "number" },
          "groupId": { "type": "string" },
          "summary": { "type": "string" },
          "blocks": { "type": "array" }
        }
      }
    }
  }
}
